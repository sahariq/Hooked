PORT=4000
DATABASE_URL=postgres://hooked:hooked@localhost:5432/hooked
PGSSL=false

JWT_SECRET=change_this_to_a_long_random_string

ADMIN_EMAIL=admin@hookedcrochet.com
ADMIN_PASSWORD=changeme123

CORS_ORIGIN=http://localhost:5173,http://localhost:5174

NODE_ENV=development

# --- Safepay (Pakistani payment gateway) ---
# Leave blank during development: the backend falls back to a mock checkout
# session so you can test the full order flow without a live merchant account.
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_CHECKOUT_URL=https://sandbox.getsafepay.com/checkout

# --- Resend (order confirmation emails) ---
# Leave blank during development: emails are logged to the console instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hooked <orders@hookedcrochet.com>
